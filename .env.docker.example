# Copia este archivo como ".env.docker" y completa APP_KEY.
# (.env.docker NO se sube a GitHub porque contiene claves)

APP_NAME=TechStore
APP_ENV=production
# Genera la clave con:  php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Chihuahua

# Los errores se ven con:  docker compose logs web
LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=techstore
DB_USERNAME=techstore
DB_PASSWORD=techstore_pass

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# El servicio de IA se llama por el nombre del servicio de Docker Compose
IA_SERVICE_URL=http://ia:8001

# Variables que usa la imagen de MySQL (deben coincidir con DB_*)
MYSQL_ROOT_PASSWORD=root_pass
MYSQL_DATABASE=techstore
MYSQL_USER=techstore
MYSQL_PASSWORD=techstore_pass
